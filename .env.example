# ==========================================================================
#  WARNING: THIS SERVER CAN CREATE, MODIFY AND DELETE DATAFORGE DATA
#
#  38 of its 65 MCP tools write to DataForge - including deleting whole
#  projects and versions. There is no read-only switch in this server.
#  The ONLY limit is the effective project role of the key below:
#
#    viewer / analyst      -> reads only; writes get 403 WRITE_ACCESS_DENIED
#    developer and above   -> can create, update and DELETE data
#    project owner / admin -> can also change project access and ownership
#    company admin         -> can also manage Git connections
#
#  Use a viewer/analyst key for read-only work, and point agents at a
#  non-production project version first.
# ==========================================================================
DATAFORGE_BASE_URL=https://api.prod-df.businessqlik.com
DATAFORGE_API_KEY=replace_me
DEFAULT_LANGUAGE=ru

CACHE_BACKEND=file
CACHE_DIR=./cache
CACHE_TTL_SECONDS=3600

MCP_SERVER_NAME=dataforge-semantic

# stdio            - local clients (Claude Desktop, Cursor). The default.
# streamable-http  - HTTP clients (Open WebUI, MCP Inspector). See docs/api/transports.md.
# sse              - DEPRECATED HTTP+SSE transport, kept only for existing deployments.
MCP_TRANSPORT=stdio

# --- HTTP transports only --------------------------------------------------
HOST=0.0.0.0
PORT=8080

# Path of the single MCP endpoint. Clients connect to http://<host>:<port><path>.
MCP_HTTP_PATH=/mcp

# ==========================================================================
#  WARNING: AN UNAUTHENTICATED HTTP PORT HANDS OUT THE WRITE SURFACE ABOVE
#
#  Over stdio the server is owned by the user who launched it. Over HTTP it is
#  reachable by anyone who can route to the port - with the same delete rights
#  the API key above carries. Set a token for any bind that is not loopback.
# ==========================================================================
# MCP_AUTH_TOKEN=generate-a-long-random-string

# Origin validation (DNS-rebinding protection). Comma-separated.
# Unset + loopback bind  -> protection on with localhost defaults.
# Unset + public bind    -> protection OFF, with a startup warning.
# Set                    -> protection on with exactly these values.
# MCP_ALLOWED_HOSTS=host.docker.internal:8080,localhost:8080
# MCP_ALLOWED_ORIGINS=https://openwebui.example

# CORS, only needed for MCP clients that call the endpoint from a browser.
# MCP_CORS_ORIGINS=https://openwebui.example

# Answer POSTs with one JSON object instead of an SSE stream.
MCP_JSON_RESPONSE=false

# Run without sessions: no Mcp-Session-Id, every request independent.
MCP_STATELESS=false

LOG_LEVEL=INFO
