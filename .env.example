# ==========================================================================
#  WARNING: THIS SERVER CAN CREATE, MODIFY AND DELETE DATAFORGE DATA
#
#  38 of its 65 MCP tools write to DataForge - including deleting whole
#  projects and versions. There is no read-only switch in this server.
#  The ONLY limit is the effective project role of the key below:
#
#    viewer / analyst      -> reads only; writes get 403 WRITE_ACCESS_DENIED
#    developer and above   -> can create, update and DELETE data
#    project owner / admin -> can also change project access and ownership
#    company admin         -> can also manage Git connections
#
#  Use a viewer/analyst key for read-only work, and point agents at a
#  non-production project version first.
# ==========================================================================
DATAFORGE_BASE_URL=https://api.prod-df.businessqlik.com
DATAFORGE_API_KEY=replace_me
DEFAULT_LANGUAGE=ru

CACHE_BACKEND=file
CACHE_DIR=./cache
CACHE_TTL_SECONDS=3600

MCP_SERVER_NAME=dataforge-semantic
MCP_TRANSPORT=stdio

HOST=0.0.0.0
PORT=8080

LOG_LEVEL=INFO
