# The build needs pyproject.toml, README.md and src/ - nothing else.
# Without this file the context carries the API PDFs, the runtime cache and the
# whole git history: ~40 MB of upload for a 100 KB package.
.git/
.github/
.claude/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
build/
dist/
cache/
.env
docs/
tests/
s1/
s2/
*.pdf
*.log
